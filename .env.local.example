# Which Gemma inference path to use: "google" (default) or "local".
# Switching this one value moves the whole app between cloud and a fully
# offline, on-device Ollama setup — no other code changes needed.
GEMMA_PROVIDER=google

# --- Cloud inference via Google's Gemini API (hosts Gemma 4 directly) ---
# Get a key at https://aistudio.google.com/apikey (free tier, no card required).
GOOGLE_API_KEY=
GOOGLE_MODEL=gemma-4-26b-a4b-it

# --- Text-to-speech via YarnGPT ---
# Get a free key at https://yarngpt.ai. English and Hausa voices are configured.
# Ewondo and Cameroon Pidgin speech output is not yet validated.
# Without a key, the app falls back to browser speech where a matching voice exists.
YARNGPT_API_KEY=
# Optional: override the voice per language (see https://yarngpt.ai/api-docs for the full list).
# Defaults below are a best guess by name — confirm/adjust once you can hear real output.
YARNGPT_VOICE_EN=Emma
YARNGPT_VOICE_HA=Zainab

# --- Village Watch's shared database (real scans + live alerts) ---
# Create a free Postgres database at https://neon.tech, or from the Vercel
# dashboard: your project -> Storage -> Create Database -> Postgres.
# Without this set, every page still works except /app/watch.
DATABASE_URL=
